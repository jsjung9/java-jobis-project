DB_PASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-local-password
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-5-mini
VITE_APP_API_URL=http://localhost:8081/api
CORS_ALLOWED_ORIGINS=http://localhost:3000
OAUTH2_REDIRECT_ORIGINS=http://localhost:3000
JWT_COOKIE_SECURE=false

# Set real OAuth values only when testing social login.
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
NAVER_CLIENT_ID=change-me
NAVER_CLIENT_SECRET=change-me
KAKAO_CLIENT_ID=change-me
KAKAO_CLIENT_SECRET=change-me
